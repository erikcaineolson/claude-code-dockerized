# =============================================================================
# Claude Code — Dockerized (with Codex and Gemini agent CLIs)
# Copy this file to .env and fill in your keys
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: Anthropic API Key (for Claude Code itself)
# Get yours at: https://console.anthropic.com/settings/keys
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Google Gemini CLI (optional — second-opinion code reviews via `gemini -p`)
# Free tier available. Get yours at: https://aistudio.google.com/apikey
# Codex needs no key here: it authenticates via `codex login` (ChatGPT account),
# persisted in the codex-auth volume.
# -----------------------------------------------------------------------------
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# GitHub CLI (optional — for gh commands inside the container)
# Generate a token at: https://github.com/settings/tokens
# Recommended scopes: repo, read:org, workflow
# -----------------------------------------------------------------------------
# GH_TOKEN=

# -----------------------------------------------------------------------------
# Git Configuration (optional)
# -----------------------------------------------------------------------------
# GIT_USER_NAME=Your Name
# GIT_USER_EMAIL=you@example.com

# -----------------------------------------------------------------------------
# Laravel dev database (optional — sensible dev defaults built in)
# Credentials for the dev-mariadb sibling container defined in
# docker-compose.yml. These are development-only credentials; the DB is not
# published to the host. Override here only if you want different values.
# -----------------------------------------------------------------------------
# MARIADB_ROOT_PASSWORD=root
# MARIADB_DATABASE=app
# MARIADB_USER=app
# MARIADB_PASSWORD=secret

# -----------------------------------------------------------------------------
# Docker socket access (optional)
# The compose file bind-mounts the host Docker socket so the container can run
# testcontainers and image builds. Leave unset on Docker Desktop (macOS/Windows)
# — the default of 0 works. On native Linux, set this to the host docker group
# id so the non-root `node` user can read the socket:
#   getent group docker | cut -d: -f3
# -----------------------------------------------------------------------------
# DOCKER_GID=0

# -----------------------------------------------------------------------------
# Codex worker containers (bin/codex-worker.sh)
# Host-side path of the directory bound at /projects — worker containers are
# siblings on the HOST daemon, so their bind mounts need host paths. Without
# this the script falls back to `docker inspect` of its own mounts.
# -----------------------------------------------------------------------------
# PROJECTS_HOST_ROOT=/Users/you/Projects
