# =============================================================================
# Claude Code — Dockerized (with Codex and Gemini agent CLIs)
# Copy this file to .env and fill in your keys
#
# SECURITY: agents in this container can read every key below, so limit what
# each one can do AT THE SERVICE that issued it — use a dedicated key per
# service with a spend cap (Anthropic/OpenAI/Google) and fine-grained,
# least-privilege, short-expiry tokens (GitHub). See SECURITY.md.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: Anthropic API Key (for Claude Code itself)
# Get yours at: https://console.anthropic.com/settings/keys
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Google Gemini CLI (optional — second-opinion code reviews via `gemini -p`)
# Free tier available. Get yours at: https://aistudio.google.com/apikey
# Codex needs no key here: it authenticates via `codex login` (ChatGPT account),
# persisted in the codex-auth volume.
# -----------------------------------------------------------------------------
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# GitHub tokens (optional — for gh + git over HTTPS inside the container)
#
# Declare ONE token per GitHub account using the convention:
#   GH_TOKEN_<OWNER>   where OWNER is the github.com owner/org name, UPPERCASED,
#                      with every non-alphanumeric character turned into `_`.
# git auto-routes by repo owner; for gh use `gh-for <owner> <args...>`. Each
# token stays isolated to its own account, so leaking one never exposes another.
#
#   GH_TOKEN_EFFINA=github_pat_...
#   GH_TOKEN_ERIKCAINEOLSON=github_pat_...
#
# A bare GH_TOKEN (below) still works as a single default/fallback account.
#   GH_TOKEN=
# Optional: only when a repo owner's name differs from its token's account key.
#   GH_OWNER_MAP=someorg=EFFINA,otherorg=ERIKCAINEOLSON
#
# STRONGLY RECOMMENDED: use fine-grained PATs, scoped to specific repos with the
# least permission (usually Contents + Pull requests) and a short expiry.
# Create at: https://github.com/settings/personal-access-tokens
# The container cannot limit what a token can do — only the service can. See
# SECURITY.md for the full rationale and the rest of the security model.

# -----------------------------------------------------------------------------
# Optional language toolchains (choose-your-own-adventure)
#
# Node and the agent CLIs (Claude Code, Codex, Gemini) are ALWAYS present.
# Everything below is OFF by default to keep the image lean — enable only the
# stacks you use. Changes take effect on a rebuild:
#   docker compose up -d --build
#
# Safety is the same for all of them: each toolchain's package manager runs
# third-party code at install time, confined by the container boundary and the
# egress allowlist (see SECURITY.md and egress/). If you enable the egress
# lockdown, the relevant registries (crates.io, rubygems.org, PyPI, Go proxy)
# are already allowlisted.
#
# INSTALL_PYTHON=true     # python3 + pip + venv + uv — many MCP servers/tools
#                         # assume python3 exists; the one most setups want on
# INSTALL_GO=true         # Go toolchain + sqlc
# INSTALL_PHP=true        # PHP 8.5 CLI + extensions + Composer (Laravel)
# INSTALL_RUBY=true       # Ruby + Bundler + Rails
# INSTALL_RUST=true       # Rust (rustup, minimal profile) + Cargo
# INSTALL_DOTNET=true     # .NET SDK (C#/F#), current LTS; telemetry opted out

# -----------------------------------------------------------------------------
# Git Configuration (optional)
# -----------------------------------------------------------------------------
# GIT_USER_NAME=Your Name
# GIT_USER_EMAIL=you@example.com

# -----------------------------------------------------------------------------
# Laravel dev database (optional — sensible dev defaults built in)
# Credentials for the dev-mariadb sibling container defined in
# docker-compose.yml. These are development-only credentials; the DB is not
# published to the host. Override here only if you want different values.
# -----------------------------------------------------------------------------
# MARIADB_ROOT_PASSWORD=root
# MARIADB_DATABASE=app
# MARIADB_USER=app
# MARIADB_PASSWORD=secret

# -----------------------------------------------------------------------------
# Docker socket access — REMOVED
# The host Docker socket is intentionally no longer bind-mounted: it would give
# any agent in this container control of the host daemon (a trivial escape to
# host root). DOCKER_GID is therefore unused. If you re-introduce Docker access,
# do it through a locked-down socket proxy, not a raw /var/run/docker.sock mount.
